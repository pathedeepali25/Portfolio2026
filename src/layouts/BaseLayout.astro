---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Deepali Pathe — Product Designer with 3+ years crafting calm, clear digital experiences.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- Anti-FOUC: apply saved theme before first paint -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('portfolio.theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        else document.documentElement.setAttribute('data-theme', 'dark');
      } catch (e) { document.documentElement.setAttribute('data-theme', 'dark'); }
    })();
  </script>

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Preconnect to Sanity API -->
  <link rel="preconnect" href="https://5p1ezhbv.api.sanity.io" />
  <link rel="dns-prefetch" href="https://cdn.sanity.io" />

  <!-- Fonts — non-blocking load -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300..600;1,300..500&family=Inter:wght@400;500;600&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300..600;1,300..500&family=Inter:wght@400;500;600&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,300..600;1,300..500&family=Inter:wght@400;500;600&display=swap" /></noscript>

  <!-- Analytics — queued immediately, scripts deferred to idle -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-1335Z71PCJ');
    (function loadTrackers() {
      function run() {
        var s = document.createElement('script');
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-1335Z71PCJ';
        s.async = true;
        document.head.appendChild(s);
        (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window,document,"clarity","script","x1omzde18c");
      }
      'requestIdleCallback' in window ? requestIdleCallback(run, {timeout:3000}) : setTimeout(run, 2000);
    })();
  </script>

  <slot name="head" />
</head>
<body>
  <div class="bloom-wash" id="bloomWash" aria-hidden="true"></div>
  <slot />
</body>
</html>
