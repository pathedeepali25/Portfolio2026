<script>
  // Jump filter — highlight the section currently in view
  const chips = Array.from(document.querySelectorAll('.jump-inner .chip')) as HTMLAnchorElement[];
  const jumpInner = document.getElementById('jumpInner');
  const targets = chips
    .map(c => document.querySelector(c.getAttribute('href') || ''))
    .filter(Boolean) as Element[];

  function setActive(id: string) {
    chips.forEach(c => {
      const on = c.getAttribute('href') === '#' + id;
      c.classList.toggle('active', on);
      if (on && jumpInner) {
        const cl = (c as HTMLElement).offsetLeft, cr = cl + (c as HTMLElement).offsetWidth;
        const vl = jumpInner.scrollLeft, vr = vl + jumpInner.clientWidth;
        if (cl < vl) jumpInner.scrollTo({ left: cl - 16, behavior: 'smooth' });
        else if (cr > vr) jumpInner.scrollTo({ left: cr - jumpInner.clientWidth + 16, behavior: 'smooth' });
      }
    });
  }

  const spy = () => {
    const line = 150;
    let current = targets[0] ? targets[0].id : null;
    for (const t of targets) {
      if (t.getBoundingClientRect().top <= line) current = t.id;
    }
    if (current) setActive(current);
  };
  window.addEventListener('scroll', spy, { passive: true });
  spy();
</script>
